{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "SAMARTH AI API (Express 5, Mongoose 9)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#constants/*": "./src/constants/*",
    "#db/*": "./src/db/*",
    "#middlewares/*": "./src/middlewares/*",
    "#utils/*": "./src/utils/*",
    "#services/*": "./src/services/*",
    "#integrations/*": "./src/integrations/*",
    "#modules/*": "./src/modules/*",
    "#jobs/*": "./src/jobs/*",
    "#events/*": "./src/events/*",
    "#realtime/*": "./src/realtime/*",
    "#ai/*": "./src/ai/*",
    "#seed/*": "./src/seed/*",
    "#app": "./src/app.js",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "node tests/setup/runApiTests.js",
    "db:sync-indexes": "node src/db/syncIndexes.js",
    "seed": "node src/seed/runSeed.js",
    "migrate": "node src/db/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
