# SAMARTH AI backend configuration (docs/15-env-variables.md). Copy to .env and fill in; never commit .env.
# Every value below is a placeholder. Generate each secret separately (at least 32 characters, all different):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- App and networking -------------------------------------------------------
NODE_ENV=development
PORT=8000
# Only source of emailed links. A bare origin, no path, no trailing slash. https in production.
FRONTEND_URL=http://localhost:5173
# Exact origins, comma separated. No wildcard, no paths, no trailing slashes, no empty entries.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Exact proxy hop count: Render sits behind one proxy (1). Leave empty for 0 locally.
TRUST_PROXY=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -------------------------------------------------------------------
# Atlas SRV string or local replica set; use a placeholder here and put the real value in .env only.
MONGODB_URI=
MONGODB_DB_NAME=SamarthAI

# --- Auth, cookies, CSRF --------------------------------------------------------
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_REMEMBER_EXPIRY=30d
IDENTIFIER_HASH_SECRET=
# Blank on the Vercel-rewrite topology. Required (shared parent domain) when COOKIE_SAMESITE=none.
COOKIE_DOMAIN=
# lax | strict | none. none is a split-origin fallback only.
COOKIE_SAMESITE=lax
# Must be true in production.
CSRF_ENABLED=true
ALLOW_SELF_REGISTRATION=true
# Comma separated domains, blank = any (example: gov.in,nic.in)
ALLOWED_EMAIL_DOMAINS=
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=

# --- Email ----------------------------------------------------------------------
# log (development) | memory (tests only, refused in production) | brevo (production)
EMAIL_TRANSPORT=log
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SAMARTH AI
EMAIL_REPLY_TO=

# --- Media (Cloudinary) ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting -----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Raises per-IP limits only. Must stay 1 in production; npm run test:api sets it itself.
RATE_LIMIT_IP_MULTIPLIER=1

# --- AI (optional until the AI milestone) --------------------------------------------
# mock | anthropic | gemini | openai
LLM_PROVIDER=mock
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_TIMEOUT_MS=30000
LLM_DAILY_CAP_PER_USER=200
LLM_CACHE_TTL_DAYS=7

# --- Platform admins (the internal role value is superadmin) -----------------------------------
# Comma separated entries, each "email" or "email:password" (split at the FIRST colon; a password may contain more
# colons but never a comma or leading/trailing spaces). At most 10. Checked on every server start, production included:
#   - a new email becomes a platform admin. With a password: 10 to 72 bytes, it must not contain the email address or its
#     name part (so "password = email" is refused and stops boot), and the first sign-in must change it. Without a
#     password: one set-password email is sent when the account is created (valid 30 minutes; later use "Forgot password").
#   - an existing verified, active account with that email is promoted (its sessions end, it signs in again).
#   - an unverified account is skipped with a warning. Removing an entry never demotes anyone.
# Example shape (fake values): PLATFORM_ADMINS=first.owner@example.org,second.owner@example.org:use-a-long-unique-phrase-here
PLATFORM_ADMINS=

# --- Legacy seed pair (still honoured as one more PLATFORM_ADMINS entry; prefer PLATFORM_ADMINS) -------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
